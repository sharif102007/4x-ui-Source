[Unit]
Description=x-ui Service
After=network.target
Wants=network.target

[Service]
EnvironmentFile=-/etc/default/x-ui
Environment="XRAY_VMESS_AEAD_FORCED=false"
Type=simple
WorkingDirectory=/usr/local/x-ui/
ExecStart=/usr/local/x-ui/x-ui
ExecReload=kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s
# Bound shutdown. Without this systemd waits DefaultTimeoutStopSec (90s)
# before SIGKILL, which is what made "x-ui update" sit at "Stopping x-ui...".
TimeoutStopSec=15s
# Reap child processes (xray and helpers) together with the panel.
KillMode=mixed

# Resource limits. systemd's default LimitNOFILE (1024 on many images) is the
# real ceiling on concurrent clients long before CPU or RAM is: every proxied
# connection costs at least one fd in the panel and one in Xray, and hitting it
# shows up as "accept: too many open files" plus connections that silently fail
# to establish. Xray upstream recommends the same order of magnitude.
LimitNOFILE=1048576
LimitNPROC=infinity
TasksMax=infinity

[Install]
WantedBy=multi-user.target
